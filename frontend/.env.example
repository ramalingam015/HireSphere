# Frontend environment reference. Copy to `frontend/.env` (gitignored).
# Vite bakes VITE_* values into the public JavaScript bundle: NEVER put secrets here.
# CI (.github/workflows/deploy.yml) takes VITE_API_BASE from the GitHub repo variable of the same name.

# Public HTTPS URL of the backend API. Production: https://api.example.com
# Local dev (against `docker compose up`): http://localhost:8000
VITE_API_BASE=

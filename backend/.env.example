# Backend environment reference. Copy to `backend/.env` (gitignored) and fill it in.
# This file only DOCUMENTS the variables; `backend/.env` is what is actually used:
#   - `python backend/main.py` loads it directly.
#   - docker-compose.yml reads it (the single compose file for local AND the VM):
#       local:  docker compose --env-file backend/.env up -d --build     (works without a .env too)
#       VM:     docker compose --env-file backend/.env --profile prod up -d --build
# Demo accounts are seeded on first start (see README); log in with them normally.
# With APP_ENV=production the API refuses to start if any dev default is left in place.

# development (default) | production (set on the VM: enforces the checks above)
APP_ENV=development

# -------------------------------------------------------------
# Security (required in production)
# -------------------------------------------------------------
SECRET_KEY=                       # signs JWTs. Generate: openssl rand -hex 32
ADMIN_REGISTRATION_KEY=           # passcode to register an Administrator / reset the platform
# -------------------------------------------------------------
# Public API / CORS (production)
# -------------------------------------------------------------
API_DOMAIN=api.example.com        # DNS A record -> VM public IP; Caddy issues its HTTPS cert
CORS_ORIGINS=*                    # open to any origin (demo). Or list origins, comma-separated

# -------------------------------------------------------------
# PostgreSQL + S3 storage (SeaweedFS) (production compose builds DATABASE_URL / MINIO_* from these)
# -------------------------------------------------------------
POSTGRES_PASSWORD=
MINIO_ROOT_USER=hiresphere_minio
MINIO_ROOT_PASSWORD=

# Only needed when running the API OUTSIDE Docker (`docker compose up -d db storage` + python main.py):
# DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/recruitment_db
# MINIO_ENDPOINT=http://localhost:8333
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=hiresphere

# -------------------------------------------------------------
# AI search & recommendations: Google Gemini (optional; heuristics are used without a key)
# Key: https://aistudio.google.com/app/apikey
# -------------------------------------------------------------
GEMINI_API_KEY=
# Google retires Gemini models quickly (1.5 and 2.0 are gone); this alias tracks the current Flash-Lite.
GEMINI_MODEL=gemini-flash-lite-latest

# -------------------------------------------------------------
# Email verification codes. Configure ONE provider (first with credentials wins:
# Resend > SendGrid > Brevo > Gmail > other SMTP). Details: DEPLOYMENT_GUIDE.md.
# Without a provider, dev mode prints the 6-digit code in the API log; production never logs it.
# -------------------------------------------------------------
SMTP_FROM_EMAIL=                  # sender address (must be verified with Resend/SendGrid/Brevo)
# RESEND_API_KEY=re_...
# SENDGRID_API_KEY=SG....
# BREVO_API_KEY=xkeysib-...
# Gmail (needs a 16-char App Password) or any SMTP server:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=
